---
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "../ui/card";
interface Props { name: string; title: string; query?: string }
const { name, title, query } = Astro.props;
---
<Card class="not-prose my-8">
  <CardHeader>
    <CardTitle>{title}</CardTitle>
    {query && <CardDescription>Query: “{query}”</CardDescription>}
  </CardHeader>
  <CardContent>
    <video controls preload="none" poster={`/media/${name}.jpg`} class="w-full rounded-md border">
      <source src={`/media/${name}.mp4`} type="video/mp4" />
      Your browser cannot play this video.
    </video>
    <div class="mt-3 text-sm text-muted-foreground"><slot /></div>
  </CardContent>
</Card>
