#!/usr/bin/env bash
# Start Saarthi and host it on the local network, ready to open on a phone.
#
#   ./start          HTTPS (the microphone of a phone needs it)
#   ./start --http   HTTP only (no microphone on a phone)
#   ./start --help
#
# The first start installs the packages, makes a local certificate, and downloads the models (about 3.8 GB).
# Stop the application with Ctrl+C. Run ./clear to remove all stored data.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

USE_HTTPS=1
for argument in "$@"; do
  case "$argument" in
    --http) USE_HTTPS=0 ;;
    -h | --help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unknown option: $argument (try ./start --help)" >&2; exit 2 ;;
  esac
done

say() { printf '%s\n' "$*"; }
fail() { printf 'Error: %s\n' "$*" >&2; exit 1; }

# ---- 1. The tools ----
export PATH="$HOME/.local/bin:$PATH"
command -v uv >/dev/null 2>&1 || fail "uv is not installed. Install it with: curl -LsSf https://astral.sh/uv/install.sh | sh"

say "Checking the packages..."
if ! uv sync --frozen >/dev/null 2>&1; then
  uv sync --frozen --offline >/dev/null 2>&1 || fail "The packages are not installed, and the network is not available. Run ./start with internet."
fi

# A download of a model can stall with the new transfer tool. The plain transfer is slower at the start but safe.
export HF_HUB_DISABLE_XET="${HF_HUB_DISABLE_XET:-1}"
if uv run --frozen python -m deploy.helpers models-cached >/dev/null 2>&1; then
  export HF_HUB_OFFLINE=1
  say "All models are on this machine. The application works without internet."
else
  say "Some models are not on this machine. The first start downloads them (about 3.8 GB). This can take a long time."
fi

# ---- 2. The addresses ----
PORT="$(uv run --frozen python -m deploy.helpers port)"
mapfile -t ADDRESSES < <(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || true)
HOST_NAME="$(hostname)"

# ---- 3. The certificate ----
CA_PID=""
cleanup() {
  [ -n "$CA_PID" ] && kill "$CA_PID" 2>/dev/null || true
}
trap cleanup EXIT

make_certificate() {
  command -v openssl >/dev/null 2>&1 || fail "openssl is not installed. Install it, or start with ./start --http"
  mkdir -p certs/public
  chmod 700 certs
  if [ ! -f certs/ca.pem ] || [ ! -f certs/ca.key ]; then
    say "Making the local certificate authority (one time)..."
    openssl req -x509 -newkey rsa:4096 -nodes -days 3650 -keyout certs/ca.key -out certs/ca.pem \
      -subj "/CN=Saarthi local CA" >/dev/null 2>&1
    chmod 600 certs/ca.key
    rm -f certs/saarthi.pem certs/saarthi.key
  fi
  local names="DNS:localhost,IP:127.0.0.1,DNS:${HOST_NAME},DNS:${HOST_NAME}.local" address renew=0
  for address in "${ADDRESSES[@]}"; do names+=",IP:${address}"; done
  if [ ! -f certs/saarthi.pem ] || [ ! -f certs/saarthi.key ]; then
    renew=1
  elif ! openssl x509 -in certs/saarthi.pem -noout -checkend $((30 * 86400)) >/dev/null 2>&1; then
    renew=1  # It ends in less than 30 days
  else
    for address in "${ADDRESSES[@]}"; do
      openssl x509 -in certs/saarthi.pem -noout -ext subjectAltName 2>/dev/null | grep -q "IP Address:${address}" || renew=1
    done
  fi
  if [ "$renew" = 1 ]; then
    say "Making the certificate for this machine..."
    openssl req -newkey rsa:2048 -nodes -keyout certs/saarthi.key -out certs/saarthi.csr -subj "/CN=saarthi" >/dev/null 2>&1
    printf 'subjectAltName=%s\nextendedKeyUsage=serverAuth\nbasicConstraints=CA:FALSE\n' "$names" >certs/san.ext
    # A phone accepts a certificate for at most 397 days.
    openssl x509 -req -in certs/saarthi.csr -CA certs/ca.pem -CAkey certs/ca.key -CAcreateserial \
      -days 397 -sha256 -extfile certs/san.ext -out certs/saarthi.pem >/dev/null 2>&1
    chmod 600 certs/saarthi.key
    rm -f certs/saarthi.csr certs/san.ext
  fi
  cp certs/ca.pem certs/public/ca.pem
}

SCHEME="http"
CA_PORT=8081
if [ "$USE_HTTPS" = 1 ]; then
  make_certificate
  export SAARTHI_TLS_CERT="$PWD/certs/saarthi.pem"
  export SAARTHI_TLS_KEY="$PWD/certs/saarthi.key"
  SCHEME="https"
  # Only the public certificate of the authority is served, so a phone can install it one time.
  if command -v python3 >/dev/null 2>&1; then
    python3 -m http.server "$CA_PORT" --bind 0.0.0.0 --directory certs/public >/dev/null 2>&1 &
    CA_PID=$!
  fi
fi

# ---- 4. The banner ----
say ""
say "Saarthi starts. Open these addresses on the phone (it must use the same Wi-Fi):"
if [ "${#ADDRESSES[@]}" -eq 0 ]; then
  say "  No network address found. Connect this machine to the Wi-Fi first."
  ADDRESSES=("localhost")
fi
for address in "${ADDRESSES[@]}"; do
  say "  ${SCHEME}://${address}:${PORT}/find      ask where an object is"
  say "  ${SCHEME}://${address}:${PORT}/enroll    add the belongings (the carer)"
  say "  ${SCHEME}://${address}:${PORT}/upload    send pictures"
  say "  ${SCHEME}://${address}:${PORT}/memory    see what Saarthi found in each picture"
done
if [ "$SCHEME" = https ]; then
  say ""
  say "The phone must trust the local certificate. Do this one time on each phone:"
  say "  1. Open http://${ADDRESSES[0]}:${CA_PORT}/ca.pem on the phone and install the certificate."
  say "  2. iPhone: Settings > General > About > Certificate Trust Settings, then turn on Saarthi local CA."
  say "     Android: Settings > Security > Install a certificate > CA certificate."
  say "Details: docs/backend/HTTPS.md"
fi
say ""
say "Stop with Ctrl+C. Remove all stored data with ./clear"
say ""

uv run --frozen python main.py
